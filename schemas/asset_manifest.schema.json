{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "week_id",
    "assets"
  ],
  "properties": {
    "week_id": {
      "type": "string",
      "pattern": "^m[0-9]{2}w[0-9]{2}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "week_id",
          "asset_type",
          "title",
          "description",
          "target_filename",
          "status",
          "used_by_activity_ids",
          "generation_source",
          "notes"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^m[0-9]{2}w[0-9]{2}-(img|aud|pdf)-[0-9]{3}$"
          },
          "week_id": {
            "type": "string",
            "pattern": "^m[0-9]{2}w[0-9]{2}$"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "image",
              "audio",
              "pdf",
              "worksheet",
              "reference_card",
              "example_output"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "target_filename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "needed",
              "planned",
              "generated",
              "provided",
              "missing",
              "not_required"
            ]
          },
          "used_by_activity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^m[0-9]{2}w[0-9]{2}-a[0-9]{2}$"
            }
          },
          "generation_source": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
