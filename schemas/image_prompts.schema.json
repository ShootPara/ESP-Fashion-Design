{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Prompts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "week_id",
    "image_prompts"
  ],
  "properties": {
    "week_id": {
      "type": "string",
      "pattern": "^m[0-9]{2}w[0-9]{2}$"
    },
    "image_prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "purpose",
          "target_filename",
          "visual_description",
          "style_instructions",
          "composition_notes",
          "text_in_image",
          "avoid",
          "used_by_activity_ids",
          "status"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^m[0-9]{2}w[0-9]{2}-img-[0-9]{3}$"
          },
          "purpose": {
            "type": "string"
          },
          "target_filename": {
            "type": "string"
          },
          "visual_description": {
            "type": "string"
          },
          "style_instructions": {
            "type": "string"
          },
          "composition_notes": {
            "type": "string"
          },
          "text_in_image": {
            "type": "string"
          },
          "avoid": {
            "type": "string"
          },
          "used_by_activity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^m[0-9]{2}w[0-9]{2}-a[0-9]{2}$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "needed",
              "planned",
              "generated",
              "provided",
              "missing",
              "not_required"
            ]
          }
        }
      }
    }
  }
}
