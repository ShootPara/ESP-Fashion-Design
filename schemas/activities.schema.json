{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "week_id",
    "activities"
  ],
  "properties": {
    "week_id": {
      "type": "string",
      "pattern": "^m[0-9]{2}w[0-9]{2}$"
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "localized_student_facing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "instructions",
        "success_criteria",
        "sentence_frames",
        "word_bank_label"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentence_frames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "word_bank_label": {
          "type": "string"
        }
      }
    },
    "rubric_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "excellent_en",
        "excellent_pt",
        "satisfactory_en",
        "satisfactory_pt",
        "needs_work_en",
        "needs_work_pt"
      ],
      "properties": {
        "criterion": {
          "type": "string"
        },
        "excellent_en": {
          "type": "string"
        },
        "excellent_pt": {
          "type": "string"
        },
        "satisfactory_en": {
          "type": "string"
        },
        "satisfactory_pt": {
          "type": "string"
        },
        "needs_work_en": {
          "type": "string"
        },
        "needs_work_pt": {
          "type": "string"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "week_id",
        "sequence_number",
        "title",
        "activity_type",
        "activity_type_custom",
        "summary",
        "student_facing",
        "teacher_instructions",
        "estimated_minutes",
        "skill_focus",
        "skill_focus_custom",
        "cefr_access_level",
        "cefr_target_level",
        "cefr_level",
        "materials",
        "vocabulary_refs",
        "asset_refs",
        "input",
        "steps",
        "expected_output",
        "assessment",
        "adaptations",
        "extension_options",
        "notes_for_app_design"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^m[0-9]{2}w[0-9]{2}-a[0-9]{2}$"
        },
        "week_id": {
          "type": "string",
          "pattern": "^m[0-9]{2}w[0-9]{2}$"
        },
        "sequence_number": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "activity_type": {
          "type": "string",
          "enum": [
            "warmup",
            "vocabulary_matching",
            "visual_analysis",
            "listening_comprehension",
            "pronunciation_practice",
            "guided_speaking",
            "role_play",
            "reading_comprehension",
            "writing_short_response",
            "writing_professional_text",
            "design_description",
            "peer_feedback",
            "presentation",
            "reflection",
            "assessment_task",
            "custom"
          ]
        },
        "activity_type_custom": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "student_facing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "pt"
          ],
          "properties": {
            "en": {
              "$ref": "#/$defs/localized_student_facing"
            },
            "pt": {
              "$ref": "#/$defs/localized_student_facing"
            }
          }
        },
        "teacher_instructions": {
          "type": "string"
        },
        "estimated_minutes": {
          "type": "number"
        },
        "skill_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "listening",
              "speaking",
              "reading",
              "writing",
              "vocabulary",
              "grammar",
              "pronunciation",
              "professional_communication",
              "critical_thinking",
              "visual_literacy",
              "custom"
            ]
          }
        },
        "skill_focus_custom": {
          "type": "string"
        },
        "cefr_access_level": {
          "type": "string",
          "enum": [
            "A1",
            "A2",
            "B1",
            "B2",
            "C1"
          ]
        },
        "cefr_target_level": {
          "type": "string",
          "enum": [
            "A1",
            "A2",
            "B1",
            "B2",
            "C1"
          ]
        },
        "cefr_level": {
          "type": "string",
          "enum": [
            "A1",
            "A2",
            "B1",
            "B2",
            "C1",
            "A1-A2",
            "A2-B1",
            "B1-B2",
            "B2-C1"
          ]
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vocabulary_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^m[0-9]{2}w[0-9]{2}-v[0-9]{3}$"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^m[0-9]{2}w[0-9]{2}-(img|aud|pdf)-[0-9]{3}$"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_type",
            "prompt_en",
            "prompt_pt",
            "items"
          ],
          "properties": {
            "input_type": {
              "type": "string"
            },
            "prompt_en": {
              "type": "string"
            },
            "prompt_pt": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_number",
              "title",
              "student_action_en",
              "student_action_pt",
              "teacher_action",
              "estimated_minutes",
              "mode"
            ],
            "properties": {
              "step_number": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "student_action_en": {
                "type": "string"
              },
              "student_action_pt": {
                "type": "string"
              },
              "teacher_action": {
                "type": "string"
              },
              "estimated_minutes": {
                "type": "number"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "individual",
                  "pair",
                  "small_group",
                  "whole_class",
                  "teacher_led",
                  "app_individual",
                  "app_pair"
                ]
              }
            }
          }
        },
        "expected_output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "description_en",
            "description_pt",
            "length_or_format"
          ],
          "properties": {
            "mode": {
              "type": "string"
            },
            "description_en": {
              "type": "string"
            },
            "description_pt": {
              "type": "string"
            },
            "length_or_format": {
              "type": "string"
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "completion_criteria_en",
            "completion_criteria_pt",
            "checklist_en",
            "checklist_pt",
            "rubric",
            "model_response_en",
            "model_response_pt",
            "common_errors",
            "feedback_prompts_en",
            "feedback_prompts_pt"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "completion",
                "checklist",
                "rubric",
                "model_response",
                "teacher_review",
                "self_check",
                "peer_feedback"
              ]
            },
            "completion_criteria_en": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "completion_criteria_pt": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "checklist_en": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "checklist_pt": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rubric": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rubric_item"
              }
            },
            "model_response_en": {
              "type": "string"
            },
            "model_response_pt": {
              "type": "string"
            },
            "common_errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "feedback_prompts_en": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "feedback_prompts_pt": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "adaptations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "support",
            "challenge"
          ],
          "properties": {
            "support": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "challenge": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "extension_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes_for_app_design": {
          "type": "string"
        }
      }
    }
  }
}
